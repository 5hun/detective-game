{
  "name": "animal-detective",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.tests.json && node --test dist/tests/engine.test.js",
    "test:browser": "npm run build && tsc -p tsconfig.tests.json && node dist/tests/browser.js",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "eslint": "^10.13.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
